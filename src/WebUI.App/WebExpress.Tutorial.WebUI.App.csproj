<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="settings\webexpress.settings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WebExpress.WebApp" Version="2.0.1-alpha" Condition="'$(Configuration)' != 'DebugLocal'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../WebUI/WebExpress.Tutorial.WebUI.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="settings\webexpress.settings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<PropertyGroup>
		<PackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</PackageRoot>
	</PropertyGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
		<Exec Command="&quot;$(TargetDir)$(AssemblyName).exe&quot; -s &quot;$(PackageRoot)\WebExpress.Tutorial.WebUI.spec&quot; -c $(Configuration) -t $(TargetFramework) -o &quot;$(PackageRoot)\pkg\$(Configuration)&quot;" />
	</Target>

</Project>
